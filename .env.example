# Copy to .env and fill in. .env is gitignored — never commit the token.
#
# On Netlify these go in Site settings → Environment variables instead.

SANITY_PROJECT_ID=dzj440zw
SANITY_DATASET=production

# Only needed for `npm run import`, or if the dataset is private.
# Create one at sanity.io/manage → API → Tokens (Editor permission).
SANITY_TOKEN=
