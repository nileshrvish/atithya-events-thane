{
  "name": "atithya-events-thane",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site for Atithya Events Thane. Content managed in Sanity, baked into static HTML at build time.",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js && node scripts/serve.js",
    "extract": "node scripts/extract-content.js",
    "import": "node scripts/import-to-sanity.js",
    "migrate": "node scripts/migrate-header-footer.js",
    "studio": "npm --prefix studio run dev"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@sanity/client": "^6.21.3",
    "@sanity/image-url": "^1.0.2",
    "handlebars": "^4.7.8"
  }
}
